# ---- Vercel project environment variables (Settings > Environment Variables) ----
# Stripe (same test keys as the old config.php). One pair for all regions;
# optional per-region overrides: STRIPE_SECRET_KEY_US / _CA / _UK, STRIPE_PUBLISHABLE_KEY_US ...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Webhook signing secret(s) from Stripe > Developers > Webhooks (endpoint .../api/stripe-webhook?region=US)
STRIPE_WEBHOOK_SECRET=whsec_...

# Zoho CRM standalone function (REST API, API key). Leave empty to skip the CRM call.
ZOHO_CRM_FUNCTION_URL=https://www.zohoapis.com/crm/v7/functions/sikhri_record_donation/actions/execute?auth_type=apikey&zapikey=...

# Extra browser origins allowed to call the API (comma separated). *.webflow.io is always allowed.
ALLOWED_ORIGINS=

# ---- Front end (only when the form is hosted somewhere else, e.g. Webflow) ----
# VITE_API_BASE=https://sikhri-donation-form.vercel.app
